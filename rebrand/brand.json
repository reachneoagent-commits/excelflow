{
  "name": "Excelflow",
  "bundle": "com.excelflow.app",
  "repo": "reachneoagent-commits/excelflow",
  "upstream_name": "GridCraft",
  "_comment": "Every change to an upstream-owned file. Applied in order by rebrand/apply.py; see docs/UPSTREAM.md.",
  "edits": [
    {
      "file": "apps/gridcraft/src/main.rs",
      "find": "\"GridCraft update helper failed",
      "replace": "\"Excelflow update helper failed"
    },
    {
      "file": "apps/gridcraft/src/main.rs",
      "find": "println!(\"GridCraft {}\"",
      "replace": "println!(\"Excelflow {}\""
    },
    {
      "file": "apps/gridcraft/src/main.rs",
      "find": "\"GridCraft doesn't open",
      "replace": "\"Excelflow doesn't open"
    },
    {
      "file": "apps/gridcraft/src/app_dirs.rs",
      "find": "Application Support/GridCraft\"",
      "replace": "Application Support/Excelflow\""
    },
    {
      "file": "apps/gridcraft/src/app_dirs.rs",
      "find": ".join(\"GridCraft\")",
      "replace": ".join(\"Excelflow\")"
    },
    {
      "file": "apps/gridcraft/src/app_dirs.rs",
      "find": ".join(\"gridcraft\")",
      "replace": ".join(\"excelflow\")"
    },
    {
      "file": "crates/ui-egui/src/channel.rs",
      "find": "\"ai.storyteller.gridcraft\"",
      "replace": "\"com.excelflow.app\""
    },
    {
      "file": "crates/ui-egui/src/channel.rs",
      "find": "GridCraft",
      "replace": "Excelflow"
    },
    {
      "file": "crates/ui-egui/src/framework.rs",
      "find": "const APP_ID: &str = \"ai.storyteller.gridcraft\";",
      "replace": "const APP_ID: &str = \"com.excelflow.app\";"
    },
    {
      "file": "crates/ui-egui/src/framework.rs",
      "find": "name: \"GridCraft\"",
      "replace": "name: \"Excelflow\""
    },
    {
      "file": "apps/gridcraft/src/native_menu.rs",
      "find": "Submenu::new(\"GridCraft\"",
      "replace": "Submenu::new(\"Excelflow\""
    },
    {
      "file": "apps/gridcraft/src/native_menu.rs",
      "find": "\"About GridCraft\"",
      "replace": "\"About Excelflow\""
    },
    {
      "file": "apps/gridcraft/src/native_menu.rs",
      "find": "\"Quit GridCraft\"",
      "replace": "\"Quit Excelflow\""
    },
    {
      "file": "packaging/macos/Info.plist.in",
      "find": "Copyright © the GridCraft authors.",
      "replace": "Copyright © Reach Neo."
    },
    {
      "file": "packaging/macos/Info.plist.in",
      "find": "<string>ai.storyteller.gridcraft</string>",
      "replace": "<string>com.excelflow.app</string>"
    },
    {
      "file": "packaging/macos/Info.plist.in",
      "find": "GridCraft",
      "replace": "Excelflow"
    },
    {
      "file": "packaging/macos/package.sh",
      "find": "GridCraft",
      "replace": "Excelflow"
    },
    {
      "file": "packaging/windows/gridcraft.wxs",
      "find": "Learning Machines LLC",
      "replace": "Reach Neo"
    },
    {
      "file": "packaging/windows/gridcraft.wxs",
      "find": "https://getartcraft.com/apps/gridcraft",
      "replace": "https://github.com/reachneoagent-commits/excelflow"
    },
    {
      "file": "packaging/windows/gridcraft.wxs",
      "find": "https://discord.gg/artcraft",
      "replace": "https://github.com/reachneoagent-commits/excelflow"
    },
    {
      "file": "packaging/windows/gridcraft.wxs",
      "find": "<Directory Id=\"CraftSuiteFolder\" Name=\"ArtCraft\">",
      "replace": "<Directory Id=\"CraftSuiteFolder\" Name=\"FlowApps\">"
    },
    {
      "file": "packaging/windows/gridcraft.wxs",
      "find": "GridCraft",
      "replace": "Excelflow"
    },
    {
      "file": "apps/gridcraft/tests/mac_menu_appkit.rs",
      "find": "assert_eq!(tops, [\"GridCraft\",",
      "replace": "assert_eq!(tops, [\"Excelflow\","
    }
  ],
  "prepend": [
    {
      "file": "CLAUDE.md",
      "marker": "<!-- Excelflow (rebrand/apply.py) -->",
      "lines": [
        "<!-- Excelflow (rebrand/apply.py) -->",
        "# Excelflow",
        "",
        "This repository is **Excelflow**, a fork of GridCraft. Read `docs/UPSTREAM.md` first. In short:",
        "",
        "- Never hand-edit a file that came from upstream to change branding, ids, links or icons: add the",
        "  change to `rebrand/brand.json` (or a patch in `rebrand/patches/`) and run `python3 rebrand/apply.py`,",
        "  so it survives the next upstream merge.",
        "- Excelflow's own files are `rebrand/`, `brand/`, `docs/UPSTREAM.md`, `README.md`,",
        "  `assets/header-*.png` and `.github/workflows/release.yml` / `windows-release.yml`.",
        "- Crate, binary and environment-variable names stay `gridcraft*` / `GRIDCRAFT_*`.",
        ""
      ]
    }
  ],
  "append": [
    {
      "file": "NOTICE",
      "marker": "Excelflow is a modified version",
      "lines": [
        "",
        "Excelflow",
        "",
        "Excelflow is a modified version of GridCraft, made by Reach Neo as part of the FlowApps suite.",
        "It changes the name, icon, identifiers and links and removes the Discord and ArtCraft links;",
        "rebrand/brand.json and rebrand/patches/ list every change.",
        "Excelflow is not affiliated with or endorsed by the ArtCraft Team. The Excelflow name and mark",
        "(brand/, assets/app-icon/) are not covered by the license above."
      ]
    },
    {
      "file": ".gitattributes",
      "marker": "(rebrand/apply.py): files we replace whole",
      "lines": [
        "",
        "# Excelflow (rebrand/apply.py): files we replace whole keep our version in a merge.",
        "# Needs `git config merge.ours.driver true` once per clone (docs/UPSTREAM.md).",
        "README.md merge=ours",
        ".github/workflows/release.yml merge=ours",
        ".github/workflows/windows-release.yml merge=ours",
        "assets/app-icon/** merge=ours"
      ]
    },
    {
      "file": ".gitignore",
      "marker": "# FlowApps release builds",
      "lines": [
        "# FlowApps release builds and editor files",
        "/*.dmg",
        "/*.msi",
        "*.exe",
        "*.zip",
        ".vscode/",
        ".idea/",
        "*.swp",
        "*.swo"
      ]
    }
  ]
}
